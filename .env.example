# Copy to .env.local for local development. Never commit real values.
VITE_PAYMENTS_ENABLED=false
# Google Form for the early-access list (https only). Empty = no early-access card.
VITE_WAITLIST_URL=
# Cloudflare Web Analytics token (32 hex characters). Empty = no analytics script.
VITE_CF_ANALYTICS_TOKEN=
# Public address of the site, used for canonical links, Open Graph tags and sitemap.xml.
VITE_SITE_URL=https://bakaya.pages.dev
